ENVIRONMENT=development

# Postgres
POSTGRES_USER=deanon
POSTGRES_PASSWORD=deanon_dev_password
POSTGRES_DB=deanon
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://deanon:deanon_dev_password@postgres:5432/deanon

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=deanon_dev_password

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional third-party threat-intel credentials — leave unset to run Argus
# without them. Each source reports NOT_CONFIGURED (never fake data) until
# its key is set here. See docs/ARCHITECTURE.md.
# URLHAUS_API_KEY=          # abuse.ch Auth-Key header — https://auth.abuse.ch/
# MALWAREBAZAAR_API_KEY=    # abuse.ch Auth-Key header — https://auth.abuse.ch/
# CHAINABUSE_API_KEY=       # https://www.chainabuse.com/api
# HIBP_API_KEY=             # paid key, per-email lookup only — https://haveibeenpwned.com/API/Key
